{
  "name": "supabase-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sitemap.js",
    "start": "next start",
    "format": "git ls-files \"**/*.{ts,tsx,md,json,css,html}\" | xargs -r biome format --write",
